# Copy this file to .env and adjust values for your environment.
# .env is gitignored — never commit real secrets.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://sjokoloko:sjokoloko_dev@localhost:5432/sjokoloko_db

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Use a Gmail "App password" — not the account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sjoko Loco <noreply@sjokoloco.no>

# Public site URLs used inside transactional email bodies. Canonical
# storefront URL is the bare apex (no `www`).
STOREFRONT_URL=https://sjokoloco.no
ADMIN_URL=https://admin.sjokoloco.no

# Internal "new signup / new order" notification recipients.
# Comma-separated list (e.g. "terje@sjokoloco.no,andreas@sjokoloco.no").
ADMIN_NOTIFY_EMAILS=

# When set, every transactional email is rewritten to this address. Use it
# in dev/staging to avoid hitting real customers. Leave empty in production.
EMAIL_TEST_OVERRIDE=

# ── Vipps MobilePay ePayment ──────────────────────────────────────────────
# Test environment by default; switch VIPPS_BASE_URL to https://api.vipps.no
# for production. All four credential values come from the Vipps developer
# portal (https://portal.vipps.no/).
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
VIPPS_SYSTEM_NAME=sjokoloko
VIPPS_SYSTEM_VERSION=1.0.0
VIPPS_SYSTEM_PLUGIN_NAME=sjokoloko-vipps
VIPPS_SYSTEM_PLUGIN_VERSION=1.0.0

# URL the user is redirected back to after paying (Next.js storefront).
VIPPS_RETURN_URL_BASE=http://localhost:3000/kasse/retur

# Public HTTPS URL Vipps will POST webhooks to. In dev, use ngrok or
# cloudflared to expose your local Django dev server. Pass this same URL to
# `python manage.py vipps_register_webhooks`.
VIPPS_WEBHOOK_URL=

# Prefix used in the merchant `reference` field. Lowercase per Vipps docs.
VIPPS_REFERENCE_PREFIX=sl

# Outbound HTTP timeout for Vipps calls (seconds).
VIPPS_HTTP_TIMEOUT=4

# Log level for the apps.payments_vipps logger.
VIPPS_LOG_LEVEL=INFO

# ── HORECA (B2B) portal ─────────────────────────────────────────────────
# Public self-registration (K-5). Ships CLOSED: an unapproved company can log
# in and upload files, the endpoint has no throttle, and each call sends two
# e-mails from the shop's own SMTP. Until someone is staffed to approve
# accounts, companies are created in the Django admin instead.
HORECA_SELF_REGISTRATION=False

# Ops alerts for the portal (new order, new company, new logo). Defaults to
# ADMIN_NOTIFY_EMAILS — but that list also gets every consumer order e-mail,
# so set this separately in production.
HORECA_NOTIFY_EMAILS=

# Customer logos are confidential and MUST NOT live under MEDIA_ROOT, which
# nginx serves at /media/. Defaults to <BASE_DIR>/private-media.
PRIVATE_MEDIA_ROOT=

# nginx client_max_body_size must be at least this, or large logos 413 before
# Django ever sees them.
HORECA_LOGO_MAX_BYTES=26214400
# Measured on the LONGEST edge. Placeholder until the print supplier confirms
# the edible sheet's printed width.
HORECA_LOGO_MIN_RASTER_PX=1000

# Organisasjonsnummer MOD-11 check digit. OFF by default at the client's
# request. Turn on before real customers are onboarded — org_number is unique
# and is what the accountant matches on, so a transposed pair does not bounce,
# it quietly creates a duplicate company.
HORECA_STRICT_ORG_NUMBER=False

# Order number series. Distinct from the consumer SL- prefix.
HORECA_ORDER_PREFIX=SLB
